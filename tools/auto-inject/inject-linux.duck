REM ==================================================================
REM Ghost-OS Linux Instant Auto-Inject DuckyScript
REM Target: Any Linux Desktop (GNOME / KDE / XFCE)
REM Triggers: Immediately upon USB physical insertion
REM ==================================================================

DELAY 600
CTRL ALT t
DELAY 400
STRING sh /media/$USER/GhostVault/Launch-GhostOS.sh
ENTER
